# Node classroom/API backend
CLASSROOM_PORT=8787
CLASSROOM_HOST=0.0.0.0
CLASSROOM_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase: server-side project URL and Secret key (never add VITE_ to the key)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Groq: keep the API key on the Node backend only
GROQ_API_KEY=gsk_replace_me
GROQ_MODEL=openai/gpt-oss-20b
MITRA_AI_ENABLED=false

# Vite client settings
VITE_CLASSROOM_WS_URL=ws://localhost:8787/classroom
VITE_API_BASE_URL=
VITE_MITRA_AI_ENABLED=false
# Hugging Face Settings
VITE_HF_TOKEN=hf_your_token_here
# Configurable ASR model: openai/whisper-large-v3-turbo | facebook/mms-1b-all | nvidia/canary-1b | openai/whisper-large-v3
VITE_ASR_MODEL_ID=openai/whisper-large-v3-turbo
# Configurable TTS model: facebook/mms-tts-eng
VITE_TTS_MODEL_ID=facebook/mms-tts-eng
